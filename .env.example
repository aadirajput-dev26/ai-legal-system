# ==============================================================================
# AI Legal System - Backend Environment Configuration Template
# ==============================================================================

# Server configuration
PORT=8080
NODE_ENV=development  # Set to "production" in live environments to enable secure cookies

# Database connection URL
# Local dev: postgresql://postgres:password123@localhost:5432/ai_legal_db
# Docker compose: postgresql://postgres:password123@db:5432/ai_legal_db
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT Authentication Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long_here

# Gateway RAG & Agent API keys
HIPPOCAMPUS_HOST_URL=https://db.gtwy.ai/api/rag
GTWY_PAUTHKEY=your_gateway_pauthkey_here

# Background Worker & Notification Webhook URL (n8n/viasocket)
NOTIFICATION_WEBHOOK_URL=https://your-n8n-or-viasocket-webhook-url